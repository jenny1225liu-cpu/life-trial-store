# ============================================
# 人生试玩店 (Life Trial) - 环境变量配置
# ============================================

# ---------- AI 模型配置 ----------
# 选择 AI 提供商: "gemini" | "openai"
AI_PROVIDER="gemini"

# Gemini API Key (Google AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI API Key
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# OpenAI 模型选择 (可选: gpt-4o, gpt-4o-mini, gpt-4-turbo)
OPENAI_MODEL="gpt-4o-mini"

# ---------- Supabase 数据库配置 ----------
# Supabase 项目 URL (如 https://xxxxx.supabase.co)
SUPABASE_URL=""
# Supabase 匿名密钥 (anon/public key)
SUPABASE_ANON_KEY=""

# ---------- 应用配置 ----------
# 应用运行端口
PORT=3000
# 应用 URL (用于 OAuth 回调和自引用链接)
APP_URL="http://localhost:3000"
